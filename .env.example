APP_NAME="Character Studio"
DATABASE_URL=sqlite:///./data/app.db
ASSETS_DIR=assets
OLLAMA_URL=
DIALOGUE_MODEL=qwen3:1.7b
SPEECH_PROVIDER=kokoro
VIDEO_PROVIDER=sadtalker
SPEECH_URL=
VIDEO_URL=
PROVIDER_TOKEN=
PROVIDER_TIMEOUT=1800
WORKER_POLL_SECONDS=2
SEED_CHARACTERS=true

# Keep unavailable MVP features disabled until model integration is verified.
ENABLE_AI_DRAFTS=false
ENABLE_ANIMATED_RENDERS=false

# Current MVP uses the included image and two fixed characters.
FIXED_DEMO_MODE=true

# Docker starts the bundled model service. Outside Docker, start it separately.
START_MODEL_SERVICE=false
SADTALKER_ROOT=/opt/SadTalker
SADTALKER_PYTHON=/opt/sadtalker-venv/bin/python
VIDEO_TIMEOUT=3600
